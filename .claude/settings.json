{"$schema":"https://json.schemastore.org/claude-code-settings.json","hooks":{"PostToolUse":[{"hooks":[{"command":"$CLAUDE_PROJECT_DIR/.claude/hooks/format-after-edit.sh","timeout":30,"type":"command"}],"matcher":"Write|Edit"}],"PreToolUse":[{"hooks":[{"command":"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main.py","timeout":10,"type":"command"}],"matcher":"Write|Edit"}],"SessionStart":[{"hooks":[{"command":"echo 'Reminder: read AGENTS.md and docs/architecture.md. Plan before multi-file edits. TDD for new behavior. Verify by running.'","timeout":5,"type":"command"}]}],"Stop":[{"hooks":[{"command":"echo 'Before stopping: did cargo test + clippy + fmt pass? Is there a teach-back or ADR owed for this change?'","timeout":5,"type":"command"}]}]},"permissions":{"allow":["Read","Glob","Grep","Bash(cargo *)","Bash(rustc *)","Bash(rustfmt *)","Bash(git status *)","Bash(git diff *)","Bash(git log *)","Bash(git branch *)","Bash(git checkout -b *)"],"ask":["Bash(git push *)","Bash(git commit *)","Bash(cargo publish *)"],"deny":["Bash(git push origin main *)","Bash(git push origin master *)","Bash(rm -rf *)","Read(.env)","Read(.env.*)","Read(**/*.pem)","Read(**/credentials*)"]}}